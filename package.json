{
    "name": "loopf",
    "version": "0.0.1",
    "description": "Electron + React + TypeScript desktop app",
    "main": "./out/main/index.js",
    "author": "minho.cho",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "electron-vite dev",
        "build": "electron-vite build",
        "start": "electron-vite preview",
        "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
        "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
        "typecheck": "npm run typecheck:node && npm run typecheck:web",
        "package:mac": "electron-vite build && electron-builder --mac --config",
        "package:win": "electron-vite build && electron-builder --win --config",
        "package:linux": "electron-vite build && electron-builder --linux --config",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "@electron-toolkit/preload": "^3.0.1",
        "@electron-toolkit/utils": "^4.0.0",
        "electron-store": "^11.0.2",
        "zustand": "^5.0.13"
    },
    "devDependencies": {
        "@emotion/react": "^11.14.0",
        "@types/node": "^22.10.5",
        "@types/react": "^19.0.7",
        "@types/react-dom": "^19.0.3",
        "@vitejs/plugin-react": "^4.3.4",
        "electron": "^33.3.1",
        "electron-builder": "^25.1.8",
        "electron-vite": "^2.3.0",
        "prettier": "^3.8.3",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "typescript": "^5.7.3",
        "vite": "^5.4.11"
    }
}
