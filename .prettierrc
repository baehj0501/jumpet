{
    "useTabs": false,
    "tabWidth": 4,
    "printWidth": 120,
    "endOfLine": "lf",
    "bracketSpacing": true,
    "singleAttributePerLine": true,
    "singleQuote": true,
    "jsxSingleQuote": true,
    "quoteProps": "as-needed",
    "trailingComma": "all",
    "semi": false,
    "arrowParens": "always",
    "bracketSameLine": false
}
